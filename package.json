{
  "name": "question-bank-app",
  "productName": "知识航线",
  "description": "跨网页与 Windows 桌面的面试题库和刷题工具",
  "author": "wqf12314-spec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"cross-env VITE_DESKTOP=true vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "cross-env VITE_DESKTOP=true vite build",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.knowledge.navigator",
    "productName": "知识航线",
    "artifactName": "Knowledge-Navigator-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "知识航线"
    }
  }
}
