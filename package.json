{
  "name": "question-bank-app",
  "productName": "知识航线",
  "description": "跨网页与 Windows 桌面的面试题库和刷题工具",
  "author": "wqf12314-spec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings=0",
    "ci:validate": "node scripts/validate-ci-config.mjs",
    "test:minio": "node scripts/minio-service-smoke.mjs",
    "test:minio:etag": "node scripts/minio-multipart-etag-experiment.mjs",
    "test:minio:e2e": "npm --prefix server run test:e2e:minio",
    "build:browser-test": "cross-env VITE_API_BASE_URL=http://127.0.0.1:3003 vite build",
    "test:browser": "npm run build:browser-test && npm --prefix server run build && playwright test",
    "benchmark:upload": "node scripts/upload-performance-benchmark.mjs",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"cross-env VITE_DESKTOP=true vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "cross-env VITE_DESKTOP=true vite build",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.4.14",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.0.11",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "vite": "^5.3.1",
    "wait-on": "^9.1.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.knowledge.navigator",
    "productName": "知识航线",
    "artifactName": "Knowledge-Navigator-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "知识航线"
    }
  }
}
