# Local development backend. Replace this with the deployed API URL in production.
VITE_API_BASE_URL=http://localhost:3002

# Optional local MinIO/S3-compatible object storage. Keep filesystem mode unless explicitly enabled.
STORAGE_DRIVER=filesystem
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=question-bank-private
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900
